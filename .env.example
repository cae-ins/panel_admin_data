# Modèle de configuration — copier en .env et renseigner les vraies valeurs
# NE PAS committer le fichier .env (il est dans .gitignore)

MINIO_ENDPOINT   = "http://<host>:<port>"
MINIO_ACCESS_KEY = "<access_key>"
MINIO_SECRET_KEY = "<secret_key>"

BUCKET_GOLD = "gold"

# PostgreSQL (utilisé par 09_charger_panel_pg.py)
PG_HOST     = "<host>"
PG_PORT     = "5432"
PG_DATABASE = "<database>"
PG_USER     = "<user>"
PG_PASSWORD = "<password>"
